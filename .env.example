# --- Core ---
DEMO_MODE=true
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# --- Database ---
# Demo mode uses SQLite automatically (backend/resortiq.db) - no setup required.
# To use Postgres/Supabase instead, set DATABASE_URL and DEMO_MODE=false.
DATABASE_URL=sqlite:///./resortiq.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional external AI (never required in DEMO_MODE) ---
AI_API_KEY=
